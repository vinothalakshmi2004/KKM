PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAX_UPLOAD_MB=10
TZ=Asia/Kolkata

# Online booking
PAYMENT_MODE=dummy            # dummy | razorpay (razorpay to be enabled in future)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AADHAAR_ENC_KEY=              # 32-byte key (hex) used to encrypt Aadhaar numbers
ONLINE_MAX_ACTIVE_PER_PHONE=3

# Optional: DNS servers for mongodb+srv lookups (only if Atlas fails with querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1
